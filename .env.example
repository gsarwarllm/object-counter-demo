# Copy to .env and adjust. `make` and `docker compose` both read .env.

# dev = fake detector + in-memory counts; prod = TF Serving + MongoDB
ENV=dev

# Dev server (python -m counter.entrypoints.webapp)
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Max upload size in bytes (larger uploads get 413)
MAX_UPLOAD_BYTES=10485760
# 1 = save annotated prediction images to tmp/debug
DEBUG_IMAGES=0
# DEBUG | INFO | WARNING | ERROR (DEBUG also logs each TF Serving URL)
LOG_LEVEL=INFO
# text | json (one JSON object per line)
LOG_FORMAT=text

# Monitoring profile (make monitoring): Grafana admin password; viewers need no login
# GRAFANA_ADMIN_PASSWORD=admin

# Drift monitoring: where model outputs are logged (none | memory | postgres;
# default memory in dev, postgres in prod), baselines, and the comparison window
# PREDICTION_LOG=postgres
# Days of prediction_logs rows to keep in PostgreSQL (older rows are deleted hourly; 0 = keep all)
PREDICTION_LOG_RETENTION_DAYS=30
# BASELINES_DIR=tmp/baselines
# The host folder Compose mounts as the app container's baselines (make demo uses tmp/demo/baselines)
# BASELINES_HOST_DIR=./tmp/baselines
DRIFT_WINDOW_HOURS=24
DRIFT_MIN_IMAGES=30
DRIFT_CACHE_SECONDS=300

# Releasing a candidate version (ENV=prod; make pull-models writes candidates.lock.json):
# off | shadow (background copy of each request) | canary (CANARY_PERCENT % answered by it)
RELEASE_MODE=off
CANARY_PERCENT=10
# Shadow calls run on SHADOW_WORKERS threads; beyond SHADOW_MAX_PENDING in flight they're dropped
SHADOW_WORKERS=2
SHADOW_MAX_PENDING=4
# Prometheus for make canary-check
# PROMETHEUS_URL=http://localhost:9090

# TF Serving (ENV=prod)
TFS_HOST=localhost
TFS_PORT=8501
TFS_TIMEOUT=30

# Where counts are stored: memory | mongo | postgres
# (default: memory when ENV=dev, mongo when ENV=prod)
# COUNT_REPO=postgres

# MongoDB (COUNT_REPO=mongo)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=prod_counter
MONGO_TIMEOUT=5

# PostgreSQL (COUNT_REPO=postgres). DATABASE_URL, if set, wins over the POSTGRES_* values.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=counter
POSTGRES_USER=counter
POSTGRES_PASSWORD=counter
POSTGRES_TIMEOUT=5
# DATABASE_URL=postgresql://counter:counter@localhost:5432/counter

# Integration tests: use these servers instead of starting containers
# TEST_POSTGRES_DSN=postgresql://counter:counter@localhost:5432/counter
# TEST_MONGO_HOST=localhost
# TEST_MONGO_PORT=27017

# Models: manifest, pulled versions, and the model registry used by `make *-models`
# MODELS_MANIFEST=models/models.json
# MODELS_LOCK=tmp/model/models.lock.json
# MLFLOW_TRACKING_URI=sqlite:///tmp/mlflow/registry.db
# MLFLOW_ARTIFACTS_DIR=tmp/mlflow/artifacts
